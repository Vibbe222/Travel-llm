# 运行环境：development、testing 或 production
APP_ENV=development

# 模型服务配置
MODEL_NAME=deepseek-v4-flash
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_dashscope_api_key

# 高德地图工具配置
AMAP_API_KEY=your_amap_api_key

# 外部请求配置
REQUEST_TIMEOUT_SECONDS=12
MAX_RETRIES=2
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400

# Web 搜索服务提供方：duckduckgo 或 tavily
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=your_tavily_api_key

# Redis 缓存与 LangGraph 会话 checkpoint 持久化配置
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=travel_llm
REDIS_CHECKPOINT_ENABLED=true
REDIS_CHECKPOINT_TTL_SECONDS=604800

# 日志级别
LOG_LEVEL=INFO

# API 跨域安全配置
# 生产环境应显式配置允许的来源，不要使用通配符 "*"
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_CREDENTIALS=true

# 是否要求访问本项目后端 API 时携带鉴权。
# 生产环境默认应开启；开发环境默认可关闭。
REQUIRE_API_KEYS=false
