# Runtime environment: development, testing, or production.
APP_ENV=development

# Model provider.
MODEL_NAME=deepseek-v4-flash
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_dashscope_api_key

# AMap tools.
AMAP_API_KEY=your_amap_api_key

# External request behavior.
REQUEST_TIMEOUT_SECONDS=12
MAX_RETRIES=2
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400

# Redis cache and LangGraph checkpoint persistence.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=travel_llm
REDIS_CHECKPOINT_ENABLED=true
REDIS_CHECKPOINT_TTL_SECONDS=604800

# Logging.
LOG_LEVEL=INFO

# API security.
# Use explicit origins in production. Do not use "*" when APP_ENV=production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_CREDENTIALS=true

# In production this defaults to true. In development it defaults to false.
REQUIRE_API_KEYS=false
